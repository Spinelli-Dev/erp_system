@page
@model ClientesModel
@{
    // Herdado do antigo HTML estático; a lista e o modal agora são do servidor (Clientes.cshtml.cs).
    ViewData["Title"] = "Clientes";
}

    <main class="conteudo-pagina flex-grow-1">
        <!-- HEADER PADRÃO -->
        <header class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="titulo-pagina mb-0">Clientes</h2>
            <!-- Contador Mobile: Aparece no topo APENAS no celular -->
            <div class="contador-clientes-mobile d-flex d-md-none">
                <span id="qtd-mobile">0 total</span>
            </div>
            <!-- Data atualizada Tablet/Desktop: Aparece apenas para telas maiores -->
            <span class="data-pagina d-none d-md-block" id="data-atual"></span>
        </header>

        <!-- TOOLBAR: Busca e Botões -->
        <div class="toolbar-produtos">
            <div class="search-wrapper">
                <img src="~/assets/icons/icone-pesquisar.svg" class="search-icon" alt="Lupa">
                <input type="text" class="search-input" id="buscaCliente" placeholder="Buscar cliente por nome, telefone ou cidade...">
            </div>
            
            <div class="d-flex gap-2 align-items-center">
                <div class="contador-clientes-desktop flex-shrink-0 d-none d-md-flex">
                    <span id="qtd-desktop">0 clientes</span>
                </div>
                <button type="button" class="btn-novo flex-shrink-0">
                    + NOVO
                </button>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- VERSÃO DESKTOP (TABELA) -->
        <!-- ========================================== -->
        <div class="table-responsive d-none d-lg-block mb-4 tabela-container">
            <table class="tabela-produtos tabela-clientes w-100 tabela-custom">
                <thead>
                    <tr>
                        <th>Editar</th>
                        <th class="coluna-ordenavel">Nome <span>↕</span></th>
                        <th>Telefone</th>
                        <th>CEP</th>
                        <th>Rua</th>
                        <th>Nº</th>
                        <th class="coluna-ordenavel">Bairro <span>↕</span></th>
                        <th>Comp.</th>
                        <th class="coluna-ordenavel">Cidade <span>↕</span></th>
                        <th class="coluna-ordenavel">UF <span>↕</span></th>
                        <th class="coluna-ordenavel">Compras <span>↕</span></th>
                        <th>Total Gasto</th>
                        <th>Obs.</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Linhas.Count == 0)
                    {
                        <tr><td colspan="13" class="text-center py-4">Nenhum cliente cadastrado</td></tr>
                    }
                    @foreach (var linha in Model.Linhas)
                    {
                        var c = linha.Cliente;
                        <tr class="linha-cliente">
                            <td><button type="button" class="btn-icone btn-editar-cliente" @Html.Raw(AtributosCliente(c))><img src="~/assets/icons/icone-edicao.svg" alt="Editar"></button></td>
                            <td class="col-prod nome-item">@c.Nome</td>
                            <td>@c.Telefone</td>
                            <td>@c.CEP</td>
                            <td>@c.Logradouro</td>
                            <td>@c.Numero</td>
                            <td>@c.Bairro</td>
                            <td>@(string.IsNullOrEmpty(c.Complemento) ? "—" : c.Complemento)</td>
                            <td>@c.Cidade</td>
                            <td>@c.Estado</td>
                            <td>@linha.Compras</td>
                            <td class="col-preco">@linha.TotalGasto.ToString("C", Moeda)</td>
                            <td>@(string.IsNullOrEmpty(c.Observacao) ? "—" : c.Observacao)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- ========================================== -->
        <!-- VERSÃO MOBILE (CARDS) -->
        <!-- ========================================== -->
        <div class="d-flex flex-column gap-3 d-lg-none mb-4 container-cards-clientes">
            @if (Model.Linhas.Count == 0)
            {
                <p class="text-center py-4">Nenhum cliente cadastrado</p>
            }
            @foreach (var linha in Model.Linhas)
            {
                var c = linha.Cliente;
                <div class="card-produto card-cliente">
                    <div class="d-flex justify-content-between align-items-start w-100">
                        <div class="d-flex flex-column gap-1 flex-grow-1 pe-3">
                            <span class="m-prod nome-item">@c.Nome</span>
                            <span class="m-info-secundaria telefone-item">@c.Telefone</span>
                            <span class="m-info-secundaria mt-1">
                                <span class="m-gasto-destaque">@linha.TotalGasto.ToString("C", Moeda)</span> • @linha.Compras compras
                            </span>
                            <div class="area-expandida-cliente d-none">
                                <div class="info-stacked"><span class="lbl">CEP</span><span class="val">@c.CEP</span></div>
                                <div class="info-stacked"><span class="lbl">Endereço</span><span class="val">@c.Logradouro, @c.Numero - @c.Bairro</span></div>
                                <div class="info-stacked"><span class="lbl">Complemento</span><span class="val">@(string.IsNullOrEmpty(c.Complemento) ? "—" : c.Complemento)</span></div>
                                <div class="info-stacked"><span class="lbl">Cidade/UF</span><span class="val">@c.Cidade - @c.Estado</span></div>
                                <div class="info-stacked"><span class="lbl">Obs</span><span class="val">@(string.IsNullOrEmpty(c.Observacao) ? "—" : c.Observacao)</span></div>
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-shrink-0">
                            <button type="button" class="btn-icone btn-toggle-card"><img src="~/assets/icons/icone-ver.svg" alt="Ver Mais"></button>
                            <button type="button" class="btn-icone btn-editar-cliente" @Html.Raw(AtributosCliente(c))><img src="~/assets/icons/icone-edicao.svg" alt="Editar"></button>
                        </div>
                    </div>
                </div>
            }
        </div>
            
    </main>

    <!-- ========================================== -->
    <!-- MODAL: CADASTRAR / EDITAR CLIENTE          -->
    <!-- ========================================== -->
    <div class="modal fade" id="modalCliente" tabindex="-1" aria-labelledby="modalClienteLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-bottom">
            <div class="modal-content modal-custom-content">
                
                <div class="modal-header-custom d-flex justify-content-between align-items-center">
                    <!-- O Título será trocado via JavaScript (Cadastrar Cliente / Editar Cadastro) -->
                    <h5 class="modal-title-custom" id="modalClienteLabel">Cadastrar Cliente</h5>
                </div>

                <div class="modal-body p-0 mt-3">
                    <form id="formCliente" method="post">
                        <input type="hidden" name="Cliente.Id" id="cliId" value="@Model.Cliente.Id">
                        @if (Model.ErrosFormulario.Count > 0)
                        {
                            <div class="alert alert-danger py-2 small" role="alert" id="errosCliente">
                                @foreach (var erro in Model.ErrosFormulario) { <div>@erro</div> }
                            </div>
                        }
                        <!-- g-3 dá o respiro padrão -->
                        <div class="row gx-3 gy-2">
                            
                            <!-- LINHA 1: NOME -->
                            <div class="col-12">
                                <label class="form-label-custom">Nome *</label>
                                <input type="text" class="form-control form-control-custom" id="cliNome" name="Cliente.Nome" value="@Model.Cliente.Nome" placeholder="Ex: Enéas Ferreira Carneiro">
                            </div>

                            <!-- LINHA 2: TELEFONE e CEP -->
                            <div class="col-6">
                                <label class="form-label-custom">Telefone *</label>
                                <input type="text" class="form-control form-control-custom" id="cliTel" name="Cliente.Telefone" value="@Model.Cliente.Telefone" placeholder="(xx) 9 xxxx-xxxx">
                            </div>
                            <div class="col-6">
                                <label class="form-label-custom">CEP</label>
                                <input type="text" class="form-control form-control-custom" id="cliCEP" name="Cliente.Cep" value="@Model.Cliente.Cep" placeholder="xxxxx-xxx">
                                <!-- A classe d-none d-md-block garante que esse texto suma no celular -->
                                <span class="aviso-cep d-none d-md-block">→ Rua, Bairro, Cidade e UF autopreenchidos</span>
                            </div>

                            <!-- LINHAS 3 E 4: A MÁGICA DO RESPONSIVO -->
                            <!-- RUA: 66% PC (col-md-8) | 100% Mobile (col-12) -->
                            <div class="col-12 col-md-8">
                                <label class="form-label-custom">Rua</label>
                                <input type="text" class="form-control form-control-custom" id="cliRua" name="Cliente.Rua" value="@Model.Cliente.Rua" placeholder="Automático">
                            </div>

                            <!-- N°: 33% PC (col-md-4) | 33% Mobile (col-4) -->
                            <!-- No mobile, como a Rua tomou 100%, o N° pula pra linha de baixo sozinho! -->
                            <div class="col-4 col-md-4">
                                <label class="form-label-custom">Nº</label>
                                <input type="text" class="form-control form-control-custom" id="cliNum" name="Cliente.Numero" value="@Model.Cliente.Numero" placeholder="Ex: 666">
                            </div>

                            <!-- BAIRRO: 50% PC (col-md-6) | 66% Mobile (col-8) -->
                            <!-- No mobile, senta do lado do Nº formando 100%. No PC, pula pra linha de baixo! -->
                            <div class="col-8 col-md-6">
                                <label class="form-label-custom">Bairro</label>
                                <input type="text" class="form-control form-control-custom" id="cliBairro" name="Cliente.Bairro" value="@Model.Cliente.Bairro" placeholder="Automático">
                            </div>

                            <!-- CIDADE: 33% PC (col-md-4) | 66% Mobile (col-8) -->
                            <div class="col-8 col-md-4">
                                <label class="form-label-custom">Cidade</label>
                                <input type="text" class="form-control form-control-custom" id="cliCidade" name="Cliente.Cidade" value="@Model.Cliente.Cidade" placeholder="Automático">
                            </div>

                            <!-- UF: 16% PC (col-md-2) | 33% Mobile (col-4) -->
                            <div class="col-4 col-md-2">
                                <label class="form-label-custom">UF</label>
                                <input type="text" class="form-control form-control-custom" id="cliUF" name="Cliente.Uf" value="@Model.Cliente.Uf" maxlength="2" placeholder="Automático">
                            </div>

                            <!-- COMPLEMENTO E OBSERVAÇÕES -->
                            <div class="col-12">
                                <label class="form-label-custom">Complemento</label>
                                <input type="text" class="form-control form-control-custom" id="cliComp" name="Cliente.Complemento" value="@Model.Cliente.Complemento" placeholder="Ex: Ap. 71, Bloco B">
                            </div>
                            <div class="col-12">
                                <label class="form-label-custom">Observações</label>
                                <input type="text" class="form-control form-control-custom" id="cliObs" name="Cliente.Observacao" value="@Model.Cliente.Observacao" placeholder="VIP, prefere entregas às sextas">
                            </div>

                        </div>
                    </form>
                </div>

                <div class="modal-footer-custom">
                    <!-- data-bs-dismiss fecha o modal nativamente -->
                    <button type="button" class="btn-cancelar-custom" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" form="formCliente" class="btn-salvar-custom" id="btnSalvarCliente">Salvar</button>
                </div>

            </div>
        </div>
    </div>

@functions {
    static readonly System.Globalization.CultureInfo Moeda = new("pt-BR");

    /// <summary>Dados do cliente no botão de editar: o modal é preenchido a partir deles (com o Id).</summary>
    static string AtributosCliente(MaxiMassasAPI.DTOs.Response.ClienteResponse c)
    {
        string A(string nome, string? valor) => $"data-{nome}=\"{System.Net.WebUtility.HtmlEncode(valor ?? "")}\"";
        return string.Join(" ", A("id", c.Id.ToString()), A("nome", c.Nome), A("tel", c.Telefone), A("cep", c.CEP),
            A("rua", c.Logradouro), A("num", c.Numero), A("bairro", c.Bairro), A("cidade", c.Cidade), A("uf", c.Estado),
            A("comp", c.Complemento), A("obs", c.Observacao));
    }
}

@section Scripts {
    @if (Model.ErrosFormulario.Count > 0)
    {
        <script>window.REABRIR_MODAL_CLIENTE = true;</script>
    }
    <script src="~/js/clientes.js" asp-append-version="true"></script>
}
