@{
    // Menu do painel, montado no servidor.
    var nomeUsuario = User.FindFirstValue(ClaimTypes.GivenName) ?? User.Identity?.Name ?? "Usuário";
    var perfilUsuario = User.FindFirstValue(ClaimTypes.Role) ?? "";
    var ehAdmin = User.IsInRole(nameof(TipoUsuario.Administrador));
    // Foto de perfil (claim com a versão; vazia = sem foto, usa o ícone padrão).
    var versaoFoto = User.FindFirstValue(MaxiMassasAPI.Configurations.PainelAuth.ClaimFoto);
    var urlFoto = string.IsNullOrEmpty(versaoFoto)
        ? null
        : $"/Foto/{User.FindFirstValue(ClaimTypes.NameIdentifier)}?v={versaoFoto}";
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>

    <!-- VINCULANDO AO BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- VINCULANDO AO .CSS -->
    <link rel="stylesheet" href="~/css/reset.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/componentes.css" asp-append-version="true">

    <!-- IMPORTANDO FONTE -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Gravitas+One&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Playwrite+IE:wght@100..400&display=swap" rel="stylesheet">

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/assets/images/login-logo-formulario.png">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark" style="background-color: #9A1006;">
        <div class="container-fluid">
            <!-- MARCA E TÍTULO -->
            <div class="navbar-brand d-flex align-items-center">
                <img src="~/assets/images/login-logo-formulario.png" alt="Logo" height="45" class="me-2">
                <div class="lh-1">
                    <h1 class="h6 mb-0 text-white fw-bold">Maxi Massas</h1>
                    <small style="font-size: 0.7rem; color: rgba(255,255,255,0.75);">Itápolis — Gestão</small>
                </div>
            </div>

            <!-- BOTÃO HAMBURGER (Apenas Mobile) -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral">
                <span class="fs-3 text-white">☰</span>
            </button>

            <!-- MENU DESKTOP -->
            <div class="collapse navbar-collapse d-none d-lg-flex">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Dashboard">Dashboard</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Vendas">Vendas</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Clientes">Clientes</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Estoque">Estoque</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Produtos">Produtos</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Entregas">Entregas</a></li>
                    <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Evolucao">Evolução</a></li>
                    @if (ehAdmin)
                    {
                        <li class="nav-item mx-1"><a class="nav-link text-white px-3" asp-page="/Usuarios">Usuários</a></li>
                    }
                </ul>
                <!-- AVATAR USUÁRIO DESKTOP -->
                <div class="navbar-usuario-desktop">
                    <!-- Foto (ou ícone padrão) leva a "Meu perfil" -->
                    <a asp-page="/Perfil" title="Meu perfil — @nomeUsuario">
                        @if (urlFoto is not null)
                        {
                            <img src="@urlFoto" alt="@nomeUsuario" width="50" height="50" class="rounded-circle bg-light" style="object-fit: cover;">
                        }
                        else
                        {
                            <img src="~/assets/icons/icone-usuario.svg" alt="@nomeUsuario" width="50" height="50" class="rounded-circle bg-light p-1">
                        }
                    </a>

                    <!-- Sair: encerra a sessão no servidor (POST, com proteção antifalsificação) -->
                    <form method="post" asp-page="/Logout" class="d-inline">
                        <button type="submit" class="btn btn-link text-white ms-4 p-0 btn-logout" title="Sair do Sistema" style="transition: opacity 0.2s;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                <polyline points="16 17 21 12 16 7"></polyline>
                                <line x1="21" y1="12" x2="9" y2="12"></line>
                            </svg>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </nav>

    <!-- MENU LATERAL (OFFCANVAS) - MOBILE -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="menuLateral" style="background-color: #FFFDF7; width: 250px;">
        <div class="offcanvas-header text-white" style="background-color: #9A1006;">
            <img src="~/assets/images/login-logo-formulario.png" alt="Logo" height="40" class="me-2">
            <div class="lh-1">
                <h1 class="h6 mb-0">Maxi Massas</h1>
                <small>Itápolis — Gestão</small>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column">
            <ul class="list-unstyled">
                <li><a class="nav-link-custom" asp-page="/Dashboard">Dashboard</a></li>
                <li><a class="nav-link-custom" asp-page="/Vendas">Vendas</a></li>
                <li><a class="nav-link-custom" asp-page="/Clientes">Clientes</a></li>
                <li><a class="nav-link-custom" asp-page="/Estoque">Estoque</a></li>
                <li><a class="nav-link-custom" asp-page="/Produtos">Produtos</a></li>
                <li><a class="nav-link-custom" asp-page="/Entregas">Entregas</a></li>
                <li><a class="nav-link-custom" asp-page="/Evolucao">Evolução</a></li>
                @if (ehAdmin)
                {
                    <li><a class="nav-link-custom" asp-page="/Usuarios">Usuários</a></li>
                }
            </ul>

            <!-- USUÁRIO MOBILE NO RODAPÉ DO MENU -->
            <div class="mt-auto pt-3 border-top">
                <div class="d-flex align-items-center mb-3">
                    @if (urlFoto is not null)
                    {
                        <img src="@urlFoto" alt="@nomeUsuario" width="50" height="50" class="rounded-circle bg-light me-2" style="object-fit: cover;">
                    }
                    else
                    {
                        <img src="~/assets/icons/icone-usuario.svg" alt="Usuário" width="50" class="rounded-circle bg-light p-1 me-2">
                    }
                    <div>
                        <h6 class="mb-0 nome-usuario-logado">@nomeUsuario</h6>
                        <small class="text-muted cargo-usuario-logado">@perfilUsuario</small>
                        <a class="d-block small" style="color: #9A1006;" asp-page="/Perfil">Meu perfil</a>
                    </div>
                </div>
                <form method="post" asp-page="/Logout">
                    <button type="submit" class="btn w-100 text-white btn-logout" style="background-color: #9A1006;">SAIR</button>
                </form>
            </div>
        </div>
    </div>

    @* Confirmação da última gravação (ex.: "Venda #12 registrada"), vinda de um redirect. *@
    @if (TempData["Mensagem"] is string mensagem)
    {
        <div class="conteudo-pagina pb-0" style="padding-top: 1rem;">
            <div class="alert alert-success alert-dismissible fade show mb-0" role="status">
                @mensagem
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
            </div>
        </div>
    }

    @RenderBody()

    <!-- RODAPÉ -->
    <footer class="rodape mt-auto">
        <p>Maxi Massas Itápolis • Sistema de Gestão v1.0</p>
    </footer>

    <script src="~/js/api-config.js" asp-append-version="true"></script>
    <script src="~/js/data-atual.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
