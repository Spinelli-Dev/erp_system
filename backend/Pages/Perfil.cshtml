@page
@model PerfilModel
@{
    ViewData["Title"] = "Meu Perfil";
    var u = Model.Usuario;
}

    <main class="conteudo-pagina flex-grow-1">
        <!-- HEADER PADRÃO -->
        <header class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="titulo-pagina mb-0">Meu Perfil</h2>
            <span id="data-atual" class="data-pagina d-none d-md-block"></span>
        </header>

        <div class="row g-4 mb-4">

            <!-- ESQUERDA: Foto e identificação -->
            <div class="col-12 col-lg-4">
                <div class="card-maxi h-auto d-flex flex-column align-items-center text-center p-4">
                    @if (u.TemFoto)
                    {
                        <img src="/Foto/@u.Id?v=@u.FotoAtualizadaEm!.Value.Ticks" alt="Sua foto" width="128" height="128" class="rounded-circle mb-3" style="object-fit: cover;">
                    }
                    else
                    {
                        <img src="~/assets/icons/icone-usuario.svg" alt="Sem foto" width="128" height="128" class="rounded-circle bg-light p-3 mb-3">
                    }
                    <span class="titulo-card-interno">@u.Nome</span>
                    <small class="text-muted mb-3">@@@u.Login • @u.TipoDescricao</small>

                    @if (Model.ErroFoto is not null)
                    {
                        <div class="alert alert-danger py-2 small w-100" role="alert">@Model.ErroFoto</div>
                    }

                    <!-- Escolher o arquivo já envia: a foto é recortada e reduzida no servidor -->
                    <form method="post" asp-page-handler="Foto" enctype="multipart/form-data" class="w-100" id="formFoto">
                        <label class="btn-salvar-custom w-100 d-flex justify-content-center align-items-center mb-2" style="cursor: pointer;" for="inputFoto">
                            @(u.TemFoto ? "Trocar foto" : "Adicionar foto")
                        </label>
                        <input type="file" id="inputFoto" name="foto" accept="image/jpeg,image/png,image/webp" class="d-none">
                    </form>
                    @if (u.TemFoto)
                    {
                        <form method="post" asp-page-handler="RemoverFoto" class="w-100">
                            <button type="submit" class="btn-cancelar-custom w-100">Remover foto</button>
                        </form>
                    }
                    <small class="text-muted mt-2">JPG, PNG ou WebP, até 2 MB. A foto é recortada no centro.</small>
                </div>
            </div>

            <!-- DIREITA: Dados e senha -->
            <div class="col-12 col-lg-8 d-flex flex-column gap-4">

                <!-- Dados -->
                <div class="card-maxi h-auto p-0 overflow-hidden">
                    <div class="p-3 border-bottom">
                        <span class="titulo-card-interno">Meus dados</span>
                    </div>
                    <form method="post" asp-page-handler="Dados" class="p-3">
                        @if (Model.ErroDados is not null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">@Model.ErroDados</div>
                        }
                        <div class="row gx-3 gy-3">
                            <div class="col-12">
                                <label class="form-label-custom" for="inputNome">Nome *</label>
                                <input type="text" class="form-control form-control-custom w-100" id="inputNome" name="Nome" value="@Model.Nome" maxlength="150" required>
                            </div>
                            <div class="col-12 col-md-7">
                                <label class="form-label-custom" for="inputEmail">E-mail</label>
                                <input type="email" class="form-control form-control-custom w-100" id="inputEmail" name="Email" value="@Model.Email" maxlength="150" placeholder="seu@email.com">
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label-custom" for="inputTelefone">Telefone</label>
                                <input type="tel" class="form-control form-control-custom w-100 mascara-telefone" id="inputTelefone" name="Telefone" value="@Model.Telefone" maxlength="20" placeholder="(16) 99999-9999">
                            </div>
                            <div class="col-6">
                                <label class="form-label-custom">Login</label>
                                <input type="text" class="form-control form-control-custom w-100 bg-light" value="@u.Login" readonly>
                            </div>
                            <div class="col-6">
                                <label class="form-label-custom">Perfil</label>
                                <input type="text" class="form-control form-control-custom w-100 bg-light" value="@u.TipoDescricao" readonly>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">Login e perfil de acesso são definidos pelo administrador.</small>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn-salvar-custom">Salvar dados</button>
                        </div>
                    </form>
                </div>

                <!-- Senha -->
                <div class="card-maxi h-auto p-0 overflow-hidden">
                    <div class="p-3 border-bottom">
                        <span class="titulo-card-interno">Trocar senha</span>
                    </div>
                    <form method="post" asp-page-handler="Senha" class="p-3" autocomplete="off">
                        @if (Model.ErroSenha is not null)
                        {
                            <div class="alert alert-danger py-2 small" role="alert">@Model.ErroSenha</div>
                        }
                        <div class="row gx-3 gy-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="inputSenhaAtual">Senha atual *</label>
                                <input type="password" class="form-control form-control-custom w-100" id="inputSenhaAtual" name="senhaAtual" autocomplete="current-password" required>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="inputNovaSenha">Nova senha *</label>
                                <input type="password" class="form-control form-control-custom w-100" id="inputNovaSenha" name="novaSenha" autocomplete="new-password" minlength="@MaxiMassasAPI.Services.PoliticaSenha.TamanhoMinimo" required>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label-custom" for="inputConfirmacao">Confirmar nova senha *</label>
                                <input type="password" class="form-control form-control-custom w-100" id="inputConfirmacao" name="confirmacao" autocomplete="new-password" required>
                            </div>
                        </div>
                        <small class="text-muted d-block mt-2">A nova senha deve ter @MaxiMassasAPI.Services.PoliticaSenha.Descricao.</small>
                        <div class="d-flex justify-content-end mt-3">
                            <button type="submit" class="btn-salvar-custom">Trocar senha</button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </main>

@section Scripts {
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
    <script>
        // Escolheu a foto: envia na hora (com aviso se passar de 2 MB, antes mesmo de enviar).
        document.getElementById('inputFoto').addEventListener('change', function () {
            if (!this.files.length) return;
            if (this.files[0].size > 2 * 1024 * 1024) {
                alert('A foto pode ter no máximo 2 MB.');
                this.value = '';
                return;
            }
            document.getElementById('formFoto').submit();
        });
    </script>
}
