@model PdvPageModel
@*  Tela do PDV (Nova venda e Editar venda). Herdado do antigo HTML estático; o que muda
    é o formulário de "Salvar Venda" e os dados vindos do servidor (ver PdvPageModel e pdv.js). *@
    <main class="conteudo-pagina flex-grow-1">
        
        <!-- HEADER -->
        <header class="d-flex justify-content-between align-items-center mb-4">
            <div class="d-flex align-items-center gap-3">
                <a href="/Vendas" class="icone-voltar">
                    <img src="~/assets/icons/icone-retornar.svg" alt="Voltar">
                </a>
                <h2 class="titulo-pagina mb-0">@Model.Titulo</h2>
            </div>
            <span id="data-atual" class="data-pagina d-none d-md-block"></span>
        </header>

        @if (Model.Erro is not null)
        {
            <div class="alert alert-danger py-2 mb-4" role="alert" id="erroPDV">@Model.Erro</div>
        }
        <!-- Aviso do modo edição (mostrado pelo pdv.js) -->
        <div class="alert alert-secondary py-2 mb-4 d-none" role="note" id="avisoEdicaoPDV">
            Itens, cliente e entrega desta venda já foram registrados e não mudam aqui. Para trocar itens,
            mude o status para <strong>Cancelado</strong> (os itens voltam ao estoque) e registre uma nova venda.
        </div>

        <!-- LAYOUT 3 COLUNAS -->
        <div class="row g-4 mb-4">
            
            <!-- COLUNA 1: DADOS DO CLIENTE E PEDIDO -->
            <div class="col-12 col-lg-4 d-flex flex-column gap-2">
                
                <!-- Card 1: Cliente -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo">Cliente</span>
                    <div class="position-relative mt-2">
                        <div class="search-wrapper w-100">
                            <img src="~/assets/icons/icone-pesquisar.svg" class="search-icon" alt="Lupa">
                            <input type="text" class="search-input w-100" id="buscaClientePDV" placeholder="Buscar cliente por nome ou telefone..." autocomplete="off">
                        </div>
                        <ul class="autocomplete-lista d-none" id="dropdownClientePDV"></ul>
                    </div>
                    
                    <!-- Box de Cliente Selecionado (Escondido por padrão) -->
                    <div id="boxClienteSelecionado" class="cliente-selecionado d-none mt-2">
                        <div class="d-flex flex-column">
                            <span id="nomeClientePDV" class="cliente-nome-pdv"></span>
                            <span id="telClientePDV" class="cliente-tel-pdv"></span>
                        </div>
                        <button type="button" class="btn-remover-cliente" onclick="removerClientePDV()">✕ Remover</button>
                    </div>
                </div>

                <!-- Card 2: Pedido Sugerido -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-1">Pedido Sugerido</span>
                    <span class="pdv-subtitulo mb-3" id="subtituloSugestaoPDV">Os produtos que o cliente mais pede</span>

                    <!-- Preenchido pelo pdv.js ao escolher o cliente (histórico calculado no servidor) -->
                    <div class="d-flex flex-column gap-2" id="listaSugestaoPDV">
                        <span class="pdv-subtitulo">Selecione um cliente para ver as sugestões.</span>
                    </div>
                </div>

                <!-- Card 3: Observações -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-2">Observações</span>
                    <input type="text" class="form-control form-control-custom w-100" id="obsPDV" placeholder="Ex: sem pimenta, entrega pela porta dos fundos...">
                </div>

                <!-- Card 4: Detalhes do Pedido -->
                <div class="card-venda-p pdv-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="pdv-titulo mb-0">Detalhes do Pedido</span>
                        <span class="pdv-data-hora" id="relogioPDV"></span>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="pdv-label">Data Agendada</label>
                            <input type="text" class="form-control form-control-custom w-100 mascara-data" id="dataAgendadaPDV" placeholder="DD/MM/AAAA">
                        </div>
                        <div class="col-6">
                            <label class="pdv-label">Hora Agendada</label>
                            <input type="text" class="form-control form-control-custom w-100 mascara-hora" id="horaAgendadaPDV" placeholder="HH:MM">
                        </div>
                    </div>

                    <label class="pdv-label mb-2">Tipo de Entrega</label>
                    <div class="d-flex gap-2 mb-3">
                        <button type="button" class="btn-toggle-pdv flex-grow-1 btn-tipo-entrega" data-value="Retirada">Retirada</button>
                        <button type="button" class="btn-toggle-pdv flex-grow-1 btn-tipo-entrega" data-value="Delivery">Delivery</button>
                    </div>

                    <!-- Endereço (Escondido até clicar em Delivery) -->
                    <div id="blocoEnderecoPDV" class="d-none mt-2">
                        <div class="linha-endereco">
                            <label class="pdv-label-end">Rua</label>
                            <input type="text" class="pdv-input-end flex-grow-1" id="endRuaPDV">
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <div class="linha-endereco w-50">
                                <label class="pdv-label-end">Nº</label>
                                <input type="text" class="pdv-input-end flex-grow-1" id="endNumPDV">
                            </div>
                            <div class="linha-endereco w-50">
                                <label class="pdv-label-end">Bairro</label>
                                <input type="text" class="pdv-input-end flex-grow-1" id="endBairroPDV">
                            </div>
                        </div>
                        <div class="d-flex gap-2 mt-2">
                            <div class="linha-endereco w-75">
                                <label class="pdv-label-end">Cidade</label>
                                <input type="text" class="pdv-input-end flex-grow-1" id="endCidPDV">
                            </div>
                            <div class="linha-endereco w-25">
                                <label class="pdv-label-end">UF</label>
                                <input type="text" class="pdv-input-end flex-grow-1 text-uppercase" id="endUFPDV" maxlength="2">
                            </div>
                        </div>
                        <div class="linha-endereco mt-2">
                            <label class="pdv-label-end">Comp.</label>
                            <input type="text" class="pdv-input-end flex-grow-1" id="endCompPDV">
                        </div>
                    </div>
                </div>

                <!-- Card 5: Plataforma -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-2">Plataforma do Pedido</span>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="WhatsApp">WhatsApp</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="Instagram">Instagram</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="Facebook">Facebook</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="UAI Rango">UAI Rango</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="Indicações">Indicações</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="Recorrência">Recorrência</button>
                        <button type="button" class="btn-toggle-pdv btn-plataforma" data-value="Outros">Outros</button>
                    </div>
                </div>

                <!-- Card 6: Pagamento -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-2">Forma de Pagamento</span>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="button" class="btn-toggle-pdv btn-pagamento" data-value="PIX">PIX</button>
                        <button type="button" class="btn-toggle-pdv btn-pagamento" data-value="Dinheiro">Dinheiro</button>
                        <button type="button" class="btn-toggle-pdv btn-pagamento" data-value="Cartão Débito">Cartão Débito</button>
                        <button type="button" class="btn-toggle-pdv btn-pagamento" data-value="Cartão Crédito">Cartão Crédito</button>
                    </div>
                </div>

                <!-- Card 7: Status -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-2">Status</span>
                    <!-- 2 botões por linha: w-100 para o container forçar wrap, ou w-50 nos botões (usando flex calc) -->
                    <div class="d-flex flex-wrap gap-2 btn-grid-2">
                        <button type="button" class="btn-toggle-pdv text-start btn-status" data-value="Concluído">Concluído</button>
                        <button type="button" class="btn-toggle-pdv text-start btn-status" data-value="Agendado">Agendado</button>
                        <button type="button" class="btn-toggle-pdv text-start btn-status" data-value="Pendente Pagamento">Pendente Pagamento</button>
                        <button type="button" class="btn-toggle-pdv text-start btn-status" data-value="Cancelado">Cancelado</button>
                    </div>
                </div>

            </div>

            <!-- COLUNA 2: PRODUTOS E DESCONTO -->
            <div class="col-12 col-lg-4 d-flex flex-column gap-2">
                
                <!-- Card Produtos (Cópia da lógica de reposição) -->
                <div class="card-venda-p pdv-card p-0 d-flex flex-column">
                    <div class="px-3 pt-3 pb-2">
                        <span class="pdv-titulo">Produtos</span>
                    </div>
                    <div class="p-0 pb-3" id="containerProdutosPDV">
                        <!-- O JS vai injetar a lista aqui no formato: Card > Header > Body > Linhas de sabor -->
                    </div>
                </div>

                <!-- Card Desconto -->
                <div class="card-venda-p pdv-card">
                    <span class="pdv-titulo mb-2">Desconto</span>
                    <div class="d-flex gap-2 align-items-center">
                        <!-- Switch R$ ou % -->
                        <div class="switch-desconto">
                            <button type="button" class="btn-sw active" id="btnDescRs">R$</button>
                            <button type="button" class="btn-sw" id="btnDescPct">%</button>
                        </div>
                        <input type="number" class="form-control form-control-custom flex-grow-1" id="inputValorDesconto" placeholder="0,00">
                    </div>
                </div>

            </div>

            <!-- COLUNA 3: COMANDA FINAL -->
            <div class="col-12 col-lg-4">
                
                <div class="card-venda-p pdv-card h-100 d-flex flex-column">
                    <!-- Cabeçalho Comanda -->
                    <div class="d-flex justify-content-between align-items-start mb-1">
                        <div class="d-flex flex-column">
                            <span class="pdv-titulo">Comanda</span>
                            <span class="comanda-info" id="infoComandaHeader">Pedido #0000 • Carregando...</span>
                        </div>
                        <button type="button" class="btn-imprimir">
                        <span>Imprimir</span>
                        </button>
                    </div>

                    <hr class="linha-divisoria">

                    <!-- Dados do Pedido -->
                    <div class="comanda-dados d-flex flex-column gap-1 mb-3">
                        <div class="d-flex"><span class="lbl">Nome:</span> <span class="val" id="comandaNome">---</span></div>
                        <div class="d-flex"><span class="lbl">Telefone:</span> <span class="val" id="comandaTel">---</span></div>
                        <div class="d-flex"><span class="lbl">Endereço:</span> <span class="val" id="comandaEnd">---</span></div>
                        <div class="d-flex"><span class="lbl">Entrega:</span> <span class="val" id="comandaEnt">---</span></div>
                        <div class="d-flex"><span class="lbl">Plataforma:</span> <span class="val" id="comandaPlat">---</span></div>
                        <div class="d-flex"><span class="lbl">Pagamento:</span> <span class="val" id="comandaPag">---</span></div>
                        <div class="d-flex"><span class="lbl">Obs:</span> <span class="val" id="comandaObs">---</span></div>
                    </div>

                    <hr class="linha-divisoria">

                    <!-- Tabela de Itens Comprados -->
                    <div class="d-flex justify-content-between mb-2">
                        <span class="comanda-item-head">Qtd Produto</span>
                        <span class="comanda-item-head">Valor</span>
                    </div>
                    <div class="comanda-lista-itens mb-3" id="listaItensComanda">
                        <!-- Itens vão entrar aqui via JS -->
                        <div class="text-center" style="font-size: 11px; color:#9CA3AC;">Nenhum produto selecionado</div>
                    </div>

                    <hr class="linha-divisoria">

                    <!-- Totais -->
                    <div class="d-flex justify-content-between mb-1">
                        <span class="comanda-lbl-total">Subtotal</span>
                        <span class="comanda-val-total" id="comandaSub">R$ 0,00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="comanda-lbl-total">Desconto (<span id="comandaTipoDesc">R$</span>)</span>
                        <span class="comanda-val-total text-danger" id="comandaDesc">- R$ 0,00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-3">
                        <span class="comanda-lbl-total">Taxa de Entrega</span>
                        <span class="comanda-val-total" id="comandaTaxa">R$ 0,00</span>
                    </div>

                    <!-- VALOR FINAL -->
                    <div class="d-flex justify-content-between align-items-center mb-4 mt-auto">
                        <span class="comanda-lbl-final">TOTAL</span>
                        <span class="comanda-val-final" id="comandaTotal">R$ 0,00</span>
                    </div>

                    <!-- Ações -->
                    <div class="d-flex gap-2">
                        <button type="button" class="btn-cancelar-custom flex-grow-1" id="btnLimparPDV" onclick="limparPDV()">Limpar Comanda</button>

                        <!-- Salvar: envia a comanda ao servidor. Os campos ocultos são preenchidos pelo pdv.js. -->
                        <form method="post" id="formPDV" class="flex-grow-1 d-flex">
                            <input type="hidden" name="Venda.ClienteId" id="hidClienteId">
                            <input type="hidden" name="Venda.ItensJson" id="hidItensJson">
                            <input type="hidden" name="Venda.TipoEntrega" id="hidTipoEntrega">
                            <input type="hidden" name="Venda.DataAgendada" id="hidDataAgendada">
                            <input type="hidden" name="Venda.HoraAgendada" id="hidHoraAgendada">
                            <input type="hidden" name="Venda.Rua" id="hidRua">
                            <input type="hidden" name="Venda.Numero" id="hidNumero">
                            <input type="hidden" name="Venda.Bairro" id="hidBairro">
                            <input type="hidden" name="Venda.Cidade" id="hidCidade">
                            <input type="hidden" name="Venda.Uf" id="hidUf">
                            <input type="hidden" name="Venda.Complemento" id="hidComplemento">
                            <input type="hidden" name="Venda.Plataforma" id="hidPlataforma">
                            <input type="hidden" name="Venda.Pagamento" id="hidPagamento">
                            <input type="hidden" name="Venda.Status" id="hidStatus">
                            <input type="hidden" name="Venda.TipoDesconto" id="hidTipoDesconto">
                            <input type="hidden" name="Venda.Desconto" id="hidDesconto">
                            <input type="hidden" name="Venda.Observacao" id="hidObservacao">
                            <button type="submit" class="btn-salvar-custom flex-grow-1 d-flex justify-content-center align-items-center" id="btnSalvarPDV">Salvar Venda</button>
                        </form>
                    </div>

                </div>

            </div>

        </div>
            
    </main>

    <!-- Catálogo, regra da taxa e comanda a restaurar — vindos do servidor (lidos pelo pdv.js). -->
    <script>window.PDV_DADOS = @Html.Raw(Model.DadosJson);</script>
